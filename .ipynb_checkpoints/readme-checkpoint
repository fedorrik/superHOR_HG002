# horhap annotation to superHOR annotation

# 1. run superHOR.ipynb to create separate bed files for each 2-9 mer superHOR

# 2. run commands below to create plots for each chrom

mkdir plots_per_chrom

for chrom in `cut -f 1 ../HG002_horhap.v2.1_default-colors.bed | uniq`; do 
    echo $chrom
    out_bed="plots_per_chrom/superHOR_${chrom}.bed"
    out_bed=`echo $out_bed | sed 's:_.ATERNAL::'`
    for i in {9..2}; do 
        grep "${chrom}" ../HG002_horhap.v2.1_default-colors.bed | head -1 | awk '{OFS="\t"; $9="255,255,255"; print $0}' | sed "s:chr:${i}mer_chr:" >> $out_bed
        grep "${chrom}" "superHOR_${i}mer.bed" | sed "s:chr:${i}mer_chr:" >> $out_bed
    done
    grep "${chrom}" ../HG002_horhap.v2.1_default-colors.bed >> $out_bed
done

cd plots_per_chrom

for i in *.bed; do echo $i; python3 ~/sync/bioinformatics/centromere/soft/scripts/bed_drawer.py $i > /dev/null; done 

mkdir bed; mv *.bed bed
mkdir png; mv *.png png




# 3. plot on one
out_bed=superHOR+horhap.bed
for chrom in `cut -f 1 ../HG002_horhap.v2.1_default-colors.bed | uniq`; do 
    echo $chrom
    grep "${chrom}" ../HG002_horhap.v2.1_default-colors.bed | head -1 | awk '{OFS="\t"; $9="255,255,255"; print $0}' | sed "s:chr:superHOR_chr:" >> $out_bed
    grep "${chrom}" superHORs.bed | sed "s:chr:superHOR_chr:" >> $out_bed
    grep "${chrom}" ../HG002_horhap.v2.1_default-colors.bed >> $out_bed
done

